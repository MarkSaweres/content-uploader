# Copy this file to .env and fill in your own values.
# Every key below is obtainable on a free tier / free account.

# --- Story generation ---
# Free API key from https://console.groq.com/keys (generous free-tier request quota).
GROQ_API_KEY=

# --- Background footage ---
# Free API key from https://www.pexels.com/api/ (sign up, no cost).
PEXELS_API_KEY=

# --- YouTube upload ---
# Path to the OAuth client secret JSON downloaded from Google Cloud Console
# (APIs & Services > Credentials > OAuth client ID > Desktop app).
YOUTUBE_CLIENT_SECRET_FILE=youtube_client_secret.json
# Created automatically on first run after you complete the OAuth consent flow.
YOUTUBE_TOKEN_FILE=youtube_token.json
